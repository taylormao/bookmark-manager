{
  "manifest_version": 3,
  "name": "网络收藏夹助手 (Bookmark Sync)",
  "version": "1.0.0",
  "description": "一键收藏当前网页至 Cloudflare Workers 云端，与桌面客户端及 Web 端多端实时同步与检索。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "快速收藏至网络收藏夹"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
