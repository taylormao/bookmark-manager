{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bookmark-online",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bookmarks-db",
      "database_id": "4c7fc44f-9010-496f-b161-9263d8de5e7f"
    }
  ],
  "vars": {
    "APP_TITLE": "我的网络收藏夹 (Online Bookmarks)",
    "ALLOW_PUBLIC_READ": "false"
  }
}

